{
  "name": "aisac-orbs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "specVersion": "0.2.0",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ci:local": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm arch && pnpm test && pnpm build && pnpm scan:bundle && ORB_E2E_REUSE_BUILD=1 pnpm test:e2e && pnpm req:coverage --reports-only --gate wave-00-foundation --check-lock && pnpm scan:licenses && pnpm audit --audit-level=high && pnpm scan:secrets",
    "arch": "depcruise --config .dependency-cruiser.cjs --exclude \"^(.next|reports|tests)/\" --output-type err-long .",
    "spec:ids": "tsx scripts/req-coverage.ts --emit-types --write-lock",
    "req:coverage": "tsx scripts/req-coverage.ts",
    "scan:bundle": "tsx scripts/bundle-secret-scan.ts",
    "scan:licenses": "tsx scripts/license-check.ts",
    "scan:secrets": "bash scripts/scan-secrets-working-tree.sh"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.0.8",
    "react-dom": "19.0.8",
    "server-only": "0.0.1",
    "three": "0.185.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@eslint/js": "9.39.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.185.4",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@vitest/coverage-v8": "5.0.0",
    "dependency-cruiser": "18.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-security": "4.0.1",
    "fast-check": "4.9.0",
    "js-yaml": "4.3.2",
    "lefthook": "2.1.12",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "pnpm": {
    "overrides": {
      "next@16.3.4>sharp": "-"
    }
  }
}
